      "EventReceipt": {
        "type": "object",
        "additionalProperties": true,
        "description": "One immutable terminal adjudication. Accepted receipts identify their new canonical fact; semantic duplicates identify the existing fact; terminal rejections identify no scheduler fact.",
        "required": [
          "client_sequence",
          "event_id",
          "payload_sha256",
          "disposition",
          "code",
          "canonical_event_id",
          "profile_ingestion_ordinal"
        ],
        "properties": {
          "client_sequence": {
            "type": "integer",
            "minimum": 1
          },
          "event_id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "payload_sha256": {
            "$ref": "#/components/schemas/Sha256"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "accepted",
              "semantic_duplicate",
              "terminal_rejected"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "STUDY_EVENT_ACCEPTED",
              "STUDY_EVENT_SEMANTIC_DUPLICATE",
              "STUDY_EVENT_TRANSITION_INVALID",
              "STUDY_EVENT_ID_CONFLICT",
              "STUDY_RATING_ALREADY_EFFECTIVE",
              "STUDY_RATING_VOID_TARGET_INVALID",
              "STUDY_CONTENT_REVISION_MISMATCH"
            ]
          },
          "canonical_event_id": {
            "$ref": "#/components/schemas/NullableUuid"
          },
          "profile_ingestion_ordinal": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "accepted"
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "properties": {
                "code": {
                  "const": "STUDY_EVENT_ACCEPTED"
                },
                "canonical_event_id": {
                  "$ref": "#/components/schemas/Uuid"
                },
                "profile_ingestion_ordinal": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "semantic_duplicate"
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "properties": {
                "code": {
                  "const": "STUDY_EVENT_SEMANTIC_DUPLICATE"
                },
                "canonical_event_id": {
                  "$ref": "#/components/schemas/Uuid"
                },
                "profile_ingestion_ordinal": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "terminal_rejected"
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "properties": {
                "code": {
                  "enum": [
                    "STUDY_EVENT_TRANSITION_INVALID",
                    "STUDY_EVENT_ID_CONFLICT",
                    "STUDY_RATING_ALREADY_EFFECTIVE",
                    "STUDY_RATING_VOID_TARGET_INVALID",
                    "STUDY_CONTENT_REVISION_MISMATCH"
                  ]
                },
                "canonical_event_id": {
                  "type": "null"
                },
                "profile_ingestion_ordinal": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
